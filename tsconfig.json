{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": [
    "cli/**/*.ts",
    "review/**/*.ts",
    "language/**/*.ts",
    "scripts/**/*.ts",
    "web-server/**/*.ts",
    "protocol/**/*.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
